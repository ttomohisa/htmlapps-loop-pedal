{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Loop Pedal",
  "nameJa": "Loop Pedal / ループペダル",
  "slug": "loop-pedal",
  "version": "0.4.0",
  "description": "Record up to four sounds, loop them in time, layer them together, and export the result as audio.",
  "descriptionJa": "身の回りの音を4トラックに録音し、同じ長さで繰り返しながら重ね、音声として保存します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-loop-pedal"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
